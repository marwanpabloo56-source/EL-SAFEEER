rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "marwanpabloo56@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins collection: super admin can manage admins, signed in can read
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Public read for students without login; write only for authenticated admins
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isSignedIn();
    }

    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isSignedIn();
    }

    match /centers/{centerId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isSignedIn();
    }

    match /news/{newsId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isSignedIn();
    }

    match /videos/{videoId} {
      allow read: if true;
      allow write: if isSuperAdmin() || isSignedIn();
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
